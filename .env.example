# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Session lifetime in seconds (default: 1 day)
JWT_TTL_SECONDS=86400
COOKIE_NAME=dt_token

# Comma-separated list of browser origins allowed to call the API directly
CORS_ORIGIN=http://localhost:3000

# --- Seed (npm run seed) ---
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=Admin@12345
